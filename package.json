{
  "name": "flash-router-react",
  "version": "0.1.0",
  "private": true,
  "description": "FLASH ROUTER local account and Chrome session dashboard",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @flash-router/server run dev",
    "dev:web": "npm --workspace @flash-router/web run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "npm --workspace @flash-router/server run build",
    "build:web": "npm --workspace @flash-router/web run build",
    "start": "npm --workspace @flash-router/server start",
    "setup": "node scripts/setup.mjs",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "npm --workspace @flash-router/server run typecheck",
    "typecheck:web": "npm --workspace @flash-router/web run typecheck",
    "lint": "npm run typecheck",
    "test": "node --test tests/unit/*.test.mjs",
    "test:integration": "npm run build:server && node --test tests/integration/*.test.mjs",
    "check": "npm run verify:structure && npm run lint && npm test && npm run test:integration",
    "verify:structure": "node scripts/verify-structure.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "@fastify/cors": "^11.1.0",
    "zod": "^4.1.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "playwright": "^1.56.1"
  }
}
